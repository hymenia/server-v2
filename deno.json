
{
  "imports": {
    "@hono/deno": "npm:@hono/deno@^1.0.3",
    "hono": "npm:hono@^4.13.14"
  },
  "tasks": {
    "dev": "deno run --watch --allow-read --allow-net --allow-env src/main.ts",
    "start": "deno run --allow-read --allow-net --allow-env src/main.ts",
    "check": "deno check src/main.ts",
    "fmt": "deno fmt",
    "lint": "deno lint"
  }
}
