
{
  "imports": {
    "@hono/deno": "npm:@hono/deno@^1.0.3",
    "hono": "npm:hono@^4.13.14",
    "nodemailer": "npm:nodemailer@^10.2.1",
    "postgres": "npm:postgres@^3"
  },
  "tasks": {
    "dev": "deno run --watch --env-file=.env --allow-read --allow-net --allow-env=DATABASE_URL src/main.ts",
    "start": "deno run --env-file=.env --allow-read --allow-net --allow-env=DATABASE_URL src/main.ts",
    "check": "deno check src/main.ts",
    "fmt": "deno fmt",
    "lint": "deno lint"
  }
}
